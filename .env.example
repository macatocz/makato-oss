# Langfuse tracing — copy to .env and fill in real values
# .env is gitignored; never commit credentials

# Opt-in gate — set to true to enable tracing
TRACE_TO_LANGFUSE=true

# Langfuse instance — devVM via SSH tunnel (start-langfuse-tunnel.sh from impact-claude-market)
LANGFUSE_BASE_URL=http://localhost:3333

# API keys for the "makato" project in Langfuse
# Get these from http://localhost:3333 → project "makato" → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
