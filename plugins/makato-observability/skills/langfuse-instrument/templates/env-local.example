# Langfuse observability — copy to .env.local at the consumer repo root and
# fill in the values from your Langfuse project settings → API Keys.
#
# Required for tracing:
LANGFUSE_HOST=<your-langfuse-url>
LANGFUSE_PUBLIC_KEY=<pk-lf-...>
LANGFUSE_SECRET_KEY=<sk-lf-...>

# Optional — override the service_name / service_version passed by the
# consumer's setup_tracing() call.
# OTEL_SERVICE_NAME=<service-name>
# OTEL_SERVICE_VERSION=<version>

# When these three LANGFUSE_* vars are unset, the TracerProvider is a
# silent no-op — LangGraph nodes still call tracer.start_as_current_span
# but the spans are dropped. Zero overhead for local dev without Langfuse.
