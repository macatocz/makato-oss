# Agent files use a system-enforced format (YAML frontmatter + XML memory tags)
# that is not compatible with standard markdown linting rules.
.claude/agents/
.claude/skills/

# Plugin SKILL.md files have their own schema with YAML frontmatter and
# domain-specific content that may not conform to standard markdown rules.
plugins/

# Generated prompt files (prompt-creator skill output)
prompts/
docs/superpowers

# Architecture Decision Records are governance prose with intentional long
# paragraphs (line lengths up to ~300 chars). MD013 prose-paragraph
# enforcement does not apply here.
docs/governance/adr/

# Spec artifacts are generated by skills (plan.md, stories.json, etc.) and
# follow per-skill schemas, not standard markdown conventions.
specs/

# .remember/ holds transient session state (notebooks, save-points) that
# is not standards-bearing markdown.
.remember/

# Root CHANGELOG.md is managed by release-please — it is regenerated from
# conventional-commit messages on every release, and its formatting (long
# lines, duplicate "✨ Features" headings per release section) is dictated
# by the release-please template, not by author choice.
CHANGELOG.md
